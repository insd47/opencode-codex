    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode-ai/sdk": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode-ai/sdk": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "@types/node": "^25.9.1",
    "solid-js": "*",
    "typescript": "^5.4.0"
  }
}
