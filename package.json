{
  "name": "@insd47/opencode-codex",
  "version": "0.0.0",
  "description": "OpenCode plugin for ChatGPT Plus/Pro OAuth with clean multi-account management",
  "license": "MIT",
  "author": "insd47",
  "repository": {
    "type": "git",
    "url": "https://github.com/insd47/opencode-codex"
  },
  "type": "module",
  "main": "dist/server.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node build.mjs",
